# v2 — Buscador de Referencias (prototipo). Imagem LEVE, sem torch.
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NLTK_DATA=/opt/nltk_data \
    PYTHONPATH=/app/src:/app/src/v2

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends make curl ca-certificates \
    && curl -fsSL -o /usr/local/bin/ttyd "https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.$(uname -m)" \
    && chmod +x /usr/local/bin/ttyd \
    && apt-get purge -y curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-light.txt .
RUN pip install --no-cache-dir -r requirements-light.txt yake

RUN python -c "import nltk; nltk.download('stopwords', download_dir='/opt/nltk_data'); nltk.download('rslp', download_dir='/opt/nltk_data')"

COPY src/ ./src/
COPY data/corpus.jsonl ./data/
COPY exemplo.txt ./
COPY PROPOSTA-V2-BUSCADOR-REFERENCIAS.md ./

COPY docker/entrypoint-v2.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh \
    && useradd --create-home --shell /bin/bash app \
    && chown -R app:app /app

USER app
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["shell"]
